FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
WORKDIR /build
COPY requirements-serve.txt .
RUN pip install --no-cache-dir --require-hashes --prefix=/install -r requirements-serve.txt
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
COPY --from=builder /install /usr/local
RUN useradd --uid 10001 --create-home appuser
WORKDIR /app
COPY service/ service/
COPY src/ src/
COPY cloudlayer/ cloudlayer/
COPY monitoring/ monitoring/
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
USER 10001
EXPOSE 8080
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
